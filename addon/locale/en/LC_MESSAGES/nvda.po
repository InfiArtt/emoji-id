#. Translators: Shown when no newer version exists. {version} is the installed version.
#, python-brace-format
msgid "Emoji ID versi {version} sudah versi terbaru."
msgstr "Emoji ID version {version} is the latest version."

#. Translators: Shown when a newer version exists. {new} and {installed} are version numbers.
#, python-brace-format
msgid ""
"Emoji ID versi {new} sudah tersedia. Versi yang terpasang sekarang {installed}.\n"
"\n"
"Pilih Unduh dan Pasang untuk memasangnya, Buka Halaman Rilis untuk membaca perubahannya, atau Nanti untuk menutup pesan ini."
msgstr ""
"Emoji ID version {new} is available. The installed version is {installed}.\n"
"\n"
"Choose Download and Install to install it, Open Release Page to read what changed, or Later to close this message."

#. Translators: Button that downloads and installs the new version.
msgid "Unduh dan Pasang"
msgstr "Download and Install"

#. Translators: Button that opens the release page in the web browser.
msgid "Buka Halaman Rilis"
msgstr "Open Release Page"

#. Translators: Button that closes the update message.
msgid "Nanti"
msgstr "Later"

#. Translators: Announced while the new version is being downloaded.
msgid "Mengunduh pembaruan Emoji ID..."
msgstr "Downloading the Emoji ID update..."

#. Translators: Shown when the new version could not be downloaded. {url} is the release page.
#, python-brace-format
msgid "Gagal mengunduh pembaruan. Kamu bisa mengunduhnya sendiri dari {url}"
msgstr "Could not download the update. You can download it yourself from {url}"

